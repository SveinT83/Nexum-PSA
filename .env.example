APP_NAME="Nexum PSA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Release Please and Composer provide these values automatically for normal source deployments.
# APP_VERSION=0.2.0-beta
# APP_COMMIT_SHA=0123456789abcdef0123456789abcdef01234567
APP_UPDATE_BRANCH=main
APP_GITHUB_REPOSITORY=SveinT83/Nexum-PSA
APP_UPDATE_PRERELEASES=true
# APP_GITHUB_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

WEBPUSH_ENABLED=false
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_PEM_FILE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Integration Hub is disabled until `php artisan integration-hub:bootstrap --enable` is run.
# Set exact per-environment HTTPS identity values. Do not reuse a production audience in Dev.
INTEGRATION_HUB_INSTALLATION_KEY=installation
INTEGRATION_HUB_ISSUER=
INTEGRATION_HUB_AUDIENCE=
INTEGRATION_HUB_AUTHORIZATION_SERVER=
INTEGRATION_HUB_SERVICE_ACTOR_KEY=integration_hub_mcp
INTEGRATION_HUB_GRANT_TTL_SECONDS=300
INTEGRATION_HUB_CLOCK_SKEW_SECONDS=30
INTEGRATION_HUB_GRANT_KEY_ID=v1
# Store a random key of at least 32 characters in the approved secret store; never commit it.
INTEGRATION_HUB_GRANT_KEY=
# Keep the previous key only during a documented rotation overlap.
INTEGRATION_HUB_PREVIOUS_GRANT_KEY_ID=
INTEGRATION_HUB_PREVIOUS_GRANT_KEY=
INTEGRATION_HUB_MAX_PAGE_SIZE=50
INTEGRATION_HUB_STALE_AFTER_SECONDS=900
INTEGRATION_HUB_AUDIT_RETENTION_DAYS=90
INTEGRATION_HUB_PLESK_CONNECT_TIMEOUT=3
INTEGRATION_HUB_PLESK_TIMEOUT=10
INTEGRATION_HUB_PLESK_MAX_RESPONSE_BYTES=1048576
INTEGRATION_HUB_PLESK_RETRY_MIN_MS=50
INTEGRATION_HUB_PLESK_RETRY_MAX_MS=150
INTEGRATION_HUB_TLS_TIMEOUT=5
# Service token source networks and RPM are bound explicitly by integration-hub:issue-service-token.

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_PUBLIC_HOST=localhost
VITE_DEV_SERVER_HMR_PROTOCOL=ws
